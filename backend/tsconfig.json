{
  "compilerOptions": {
    /* Configuração ESM nativa */
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "esModuleInterop": true,
    
    /* Saída de build */
    "outDir": "./dist",
    "rootDir": "./src",

    /* Tipagens e checagem */
    "strict": true,
    "skipLibCheck": true,
    "forceConsistentCasingInFileNames": true
  },
  "include": ["src/**/*"],
  "exclude": ["node_modules", "dist"]
}